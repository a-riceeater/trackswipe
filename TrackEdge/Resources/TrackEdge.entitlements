<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct-distribution build. App Sandbox is intentionally OFF: the app loads
	     Apple's private MultitouchSupport / DisplayServices frameworks and posts
	     synthetic system-defined key events, none of which the sandbox permits. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
